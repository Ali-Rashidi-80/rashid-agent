# =============================================================================
# Frontend (Next.js) — copy to frontend/.env.local for host `npm run dev`
# Do not put real secrets in this file.
# In Docker Compose, BACKEND_URL / RASHID_TOKEN are injected on the web service.
# =============================================================================

# Upstream FastAPI (BFF). In Compose use: http://api:8000
BACKEND_URL=http://127.0.0.1:8000

# Optional; only if API enforces RASHID_TOKEN
RASHID_TOKEN=

# Playwright / e2e (optional)
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
