# =============================================================================
# Rashid Agent — root env template (copy to `.env` and fill locally)
# NEVER put real secrets in this file. All secret fields stay empty.
# Frontend host: see frontend/.env.example
# Backend also loads this root `.env` (see backend/.env.example)
# =============================================================================

# --- Metis / OpenAI-compatible API ---
OPENAI_API_KEY=
METIS_API_KEY=
# Public endpoint (not a secret)
METIS_BASE_URL=https://api.metisai.ir/api/v1/wrapper/grok
METIS_OPENAI_URL=

# --- Infrastructure (host hybrid). Compose overrides host/port inside containers. ---
# Leave secrets empty here. Example shape after you fill `.env` locally:
# DATABASE_URL=postgresql+asyncpg://rashid:<PASSWORD>@127.0.0.1:5432/rashid
DATABASE_URL=
REDIS_URL=
ARQ_REDIS_URL=
POSTGRES_USER=rashid
POSTGRES_PASSWORD=
POSTGRES_DB=rashid
POSTGRES_PUBLISH_PORT=5432
REDIS_PUBLISH_PORT=6380
REDIS_PASSWORD=
API_PUBLISH_PORT=8000
WEB_PUBLISH_PORT=3000

# --- Chabokan / Docker image overrides (public registry paths only) ---
RASHID_MIRROR_PROFILE=chabokan
PYTHON_IMAGE=mirror2.chabokan.net/library/python:3.11-slim-bookworm
NODE_IMAGE=mirror2.chabokan.net/library/node:20-alpine
POSTGRES_IMAGE=mirror2.chabokan.net/pgvector/pgvector:pg16
REDIS_IMAGE=mirror2.chabokan.net/library/redis:7-alpine
# Fallback if a tag is missing on the mirror:
# POSTGRES_IMAGE=pgvector/pgvector:pg16
# REDIS_IMAGE=redis:7-alpine

# --- Server / BFF ---
RASHID_HOST=127.0.0.1
RASHID_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
RASHID_TOKEN=

# --- Model defaults (non-secret) ---
RASHID_MODEL=grok-code-fast-1
RASHID_PROVIDER=grok

# --- Debug / safety ---
RASHID_DEBUG=0
ALLOW_BLIND_APPLY=false
RASHID_SKIP_MIGRATE=0

# --- Messenger (Phase D) ---
SECRETS_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_ORG_BOT_SLUG=
TELEGRAM_API_BASE=https://api.telegram.org

# MeliPayamak console OTP (Liquidglass login pattern bodyId 477732)
SMS_CONSOLE_API_TOKEN=
MELIPAYAMAK_CONSOLE_TOKEN=
SMS_OTP_PATTERN_BODY_ID=477732
SMS_OTP_PATTERN_ARG_SLOTS=code,minutes
SMS_OTP_TTL_MINUTES=2
SMS_DELIVERY_ENABLED=1
SMS_PROVIDER_MODE=stub
SMS_PROVIDER_TIMEOUT_SECONDS=30
BALE_API_BASE=https://tapi.bale.ai

# --- Knowledge base / RAG (Phase B) ---
KB_EMBEDDING_MODEL=text-embedding-3-small
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=120
KB_TOP_K=6
KB_MAX_UPLOAD_BYTES=26214400
KB_ARQ_INGEST_MIN_BYTES=1000000
KB_OCR_VISION_MODEL=gpt-4o-mini
KB_EMBED_HASH_FALLBACK=false
KB_STORAGE_DIR=

# --- Multi-tenant seed (Phase T0) ---
TENANT_SEED_ADMIN_USER=
TENANT_SEED_ADMIN_PASSWORD=
TENANT_SEED_CODE_PROJECT_PATH=

# --- Optional ERP RAG bridge ---
ERP_RAG_BASE_URL=
ERP_RAG_USERNAME=
ERP_RAG_PASSWORD=
