# =============================================================================
# Chabokan panel checklist — split web + API
# Comment-only template. Fill values in the Chabokan dashboard; never commit secrets.
# Full raw Docker: docker-compose.chabokan.yml + root `.env`
# =============================================================================

# --- Service: API (FastAPI) ---
# DATABASE_URL=postgresql+asyncpg://USER:PASS@services.irnX.chabokan.net:PORT/DB
# REDIS_URL=redis://:PASS@services.irnY.chabokan.net:PORT/0
# ARQ_REDIS_URL=redis://:PASS@services.irnY.chabokan.net:PORT/1
# METIS_API_KEY=
# SECRETS_ENCRYPTION_KEY=
# RASHID_TOKEN=
# RASHID_HOST=0.0.0.0
# RASHID_PORT=8000
# TENANT_SEED_ADMIN_USER=
# TENANT_SEED_ADMIN_PASSWORD=

# --- Service: Worker (same image) ---
# Same DATABASE_URL / REDIS_* / METIS_* / SECRETS_ENCRYPTION_KEY as API
# RASHID_SKIP_MIGRATE=1

# --- Service: Web (Next.js) ---
# BACKEND_URL=https://api.YOUR_DOMAIN
# RASHID_TOKEN=

# --- Managed Postgres / Redis ---
# Prefer Chabokan managed hostnames when available.
# Ensure migrations create rashid_app for KB RLS (docs/multi-tenant.md)
