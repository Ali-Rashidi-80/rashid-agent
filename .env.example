# Rashid Agent — copy to .env and fill in values

# Metis / OpenAI-compatible API (legacy name kept for compatibility)
OPENAI_API_KEY=
METIS_API_KEY=
# Wrapper base: chat completions are served at <base>/chat/completions
METIS_BASE_URL=https://api.metisai.ir/api/v1/wrapper/grok
# Optional full URL override (leave empty to derive from METIS_BASE_URL)
METIS_OPENAI_URL=

# Infrastructure (defaults match docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://rashid:rashid@127.0.0.1:5432/rashid
REDIS_URL=redis://127.0.0.1:6380/0
ARQ_REDIS_URL=redis://127.0.0.1:6380/1

# Server
RASHID_HOST=127.0.0.1
RASHID_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
RASHID_TOKEN=

# When set, API requires Authorization: Bearer <token> (health stays public)
# Model
RASHID_MODEL=grok-code-fast-1
RASHID_MIRROR_PROFILE=chabokan

# Debug
RASHID_DEBUG=0
# Apply edits only after explicit preview (set true to skip gate in dev)
ALLOW_BLIND_APPLY=false
