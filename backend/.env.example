# =============================================================================
# Backend env template
# The FastAPI app loads the repo-root `.env` (see app/config/settings.py).
# Copy ../.env.example → ../.env and fill secrets there.
# Do not put real secrets in this file.
# =============================================================================

# Optional local override if you run uvicorn from backend/ with a CWD-local .env:
# (same keys as root .env.example — leave empty in the committed template)

DATABASE_URL=
REDIS_URL=
ARQ_REDIS_URL=
METIS_API_KEY=
OPENAI_API_KEY=
METIS_BASE_URL=https://api.metisai.ir/api/v1/wrapper/grok
RASHID_HOST=127.0.0.1
RASHID_PORT=8000
RASHID_TOKEN=
SECRETS_ENCRYPTION_KEY=
TENANT_SEED_ADMIN_USER=
TENANT_SEED_ADMIN_PASSWORD=
