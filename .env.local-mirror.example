# =============================================================================
# Local DR mirror — copy to `.env.local-mirror` (gitignored) and fill locally.
# Do not put real secrets in this committed example.
# Used by: docker-compose.local-mirror.yml / scripts/local-mirror-up.ps1
# =============================================================================

LOCAL_DB_NAME=rashid
LOCAL_DB_USER=rashid
LOCAL_DB_PASSWORD=
LOCAL_DB_PORT=5433
LOCAL_REDIS_PORT=6381
LOCAL_API_PORT=8001
LOCAL_WEB_PORT=3001
REDIS_PASSWORD=

METIS_API_KEY=
METIS_BASE_URL=https://api.metisai.ir/api/v1/wrapper/grok

RASHID_TOKEN=
SECRETS_ENCRYPTION_KEY=
TENANT_SEED_ADMIN_USER=
TENANT_SEED_ADMIN_PASSWORD=
TENANT_SEED_CODE_PROJECT_PATH=

RASHID_DEBUG=1
RASHID_MODEL=grok-code-fast-1
RASHID_PROVIDER=grok

PYTHON_IMAGE=mirror2.chabokan.net/library/python:3.11-slim-bookworm
NODE_IMAGE=mirror2.chabokan.net/library/node:20-alpine
LOCAL_POSTGRES_IMAGE=mirror2.chabokan.net/pgvector/pgvector:pg16
REDIS_IMAGE=mirror2.chabokan.net/library/redis:7-alpine

KB_EMBED_HASH_FALLBACK=false

# MeliPayamak OTP (use stub locally unless you set a real console token)
SMS_CONSOLE_API_TOKEN=
SMS_OTP_PATTERN_BODY_ID=477732
SMS_OTP_PATTERN_ARG_SLOTS=code,minutes
SMS_OTP_TTL_MINUTES=2
SMS_DELIVERY_ENABLED=1
SMS_PROVIDER_MODE=stub
SMS_PROVIDER_TIMEOUT_SECONDS=30
